# Copy this file to .env and fill in the values
# Never commit .env to git

# --- Local development (docker compose up) ---
DB_USER=chorequest
DB_PASSWORD=changeme
DB_NAME=chorequest

# Generate a random secret key - run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret

APP_ENV=local
FRONTEND_URL=http://localhost:5173

# Local email (MailHog via docker-compose)
SMTP_HOST=mailhog
SMTP_PORT=1025
EMAIL_FROM=noreply@chorequest.local

# --- Production (docker compose -f docker-compose.prod.yml up) ---
# DATABASE_URL=postgresql://user:password@host:5432/chorequest
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM=noreply@yourdomain.com
# FRONTEND_URL=https://your-frontend-url
# VITE_API_URL=https://your-api-url
